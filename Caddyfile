# SITE_ADDRESS is a full Caddy site address. With a bare hostname Caddy obtains
# and renews Let's Encrypt certificates automatically; with an explicit
# http:// prefix (e.g. a public IP before DNS exists) it serves plain HTTP.

{$SITE_ADDRESS} {
	encode zstd gzip

	# The API shares the site's origin. These paths go straight to the backend
	# so they never reach Next.js — whose own /api/* rewrite targets this same
	# origin and would otherwise loop.
	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy backend:3000
	}

	# Product images and bulk-import uploads are immutable once written.
	handle /uploads/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:3001
	}
}

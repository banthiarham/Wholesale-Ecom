# Copy to .env on the server and fill in. Never commit the filled-in file.
# Generate each secret with: openssl rand -hex 32

# ── Address ──────────────────────────────────────────────────────────────────
# SITE_ADDRESS is the Caddy site address. A bare hostname gets automatic HTTPS
# (its DNS A record must point at this server before the first start). To run
# on the public IP before DNS exists, use an explicit http:// address:
#   SITE_ADDRESS=http://203.0.113.10
#   SITE_URL=http://203.0.113.10
SITE_ADDRESS=example.com
SITE_URL=https://example.com

# The API is served from the same origin as the site (Caddy routes /api/v1/*
# and /uploads/* to the backend). Only set this if the API is exposed elsewhere.
API_PUBLIC_URL=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=wholesalex
POSTGRES_PASSWORD=
POSTGRES_DB=wholesalex

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=7d

# ── Encryption keys ──────────────────────────────────────────────────────────
# Used to encrypt SMTP and payment-gateway credentials stored in the database.
# Changing either of these makes already-stored credentials unreadable.
SMTP_CREDENTIALS_KEY=
GATEWAY_CREDENTIALS_KEY=

# ── Google OAuth (optional — leave blank to disable Google sign-in) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The callback URL is derived from API_PUBLIC_URL in docker-compose.yml. Add it
# to the authorised redirect URIs in the Google Cloud console:
#   https://api.example.com/api/v1/auth/google/callback

# ── Frontend analytics (optional) ────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Not set here ─────────────────────────────────────────────────────────────
# SMTP and payment-gateway credentials (Razorpay/CCAvenue) are configured
# through the admin UI at runtime, not through this file. They are stored
# encrypted in the database using the two keys above.
